# Copy to .env and adjust. All values have safe local defaults if unset.

SECRET_KEY=change-me-to-a-random-value
DATABASE_URL=sqlite:///data/phishaware.db
BASE_URL=http://127.0.0.1:5000
ORG_NAME=PhishAware Demo Org

# Admin dashboard login (bootstrapped on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Logging
LOG_DIR=logs

# Email delivery mode: "simulate" (default, safe — renders .eml files, sends nothing)
# or "ses" (sends real mail via AWS SES — only for authorized internal programs)
MAIL_MODE=simulate
OUTBOX_DIR=data/outbox
AWS_REGION=us-east-1
SES_SENDER=security-awareness@yourcompany.com

# Optional: ship event logs to AWS CloudWatch Logs in addition to the local
# logs/events.jsonl file. Requires AWS credentials in the environment
# (e.g. via `aws configure` or an IAM role) and logs:CreateLogGroup /
# logs:CreateLogStream / logs:PutLogEvents permissions — see
# aws/iam-policy-phishaware.json for a least-privilege example.
SHIP_TO_CLOUDWATCH=false
CLOUDWATCH_LOG_GROUP=/phishaware/events
CLOUDWATCH_LOG_STREAM=campaign-events